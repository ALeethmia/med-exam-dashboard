{
  "name": "med-exam-dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node scripts/build.mjs",
    "lint": "node scripts/check.mjs",
    "test": "node --test tests/core.test.js tests/planner.test.js tests/life.test.js tests/adaptive.test.js tests/kingdom.test.js tests/growth.test.js tests/course-dates.test.js tests/version.test.js tests/territory.test.js tests/kingdom-map.test.js tests/growth-i1/*.test.mjs",
